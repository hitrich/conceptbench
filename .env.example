# Generate real values with ./scripts/setup.sh. Never commit .env.
SECRET_KEY=CHANGE_ME_SECRET
CREDENTIAL_KEYS=CHANGE_ME_ENCRYPTION_KEY
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
CONCEPTBENCH_PORT=8008
# Local-only Compose defaults. For a public HTTPS host: disable demo, secure cookies,
# configure hosts/origins, and enable SSL redirect behind a trusted reverse proxy.
DEBUG=0
ALLOW_DEMO=1
ALLOW_REGISTRATION=1
COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
TRUST_PROXY_SSL_HEADER=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8008,http://127.0.0.1:8008
# Optional model generation. No keys means model-off mode; the demo still works.
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL=text-embedding-3-small
# Enter current prices; the application intentionally supplies no stale defaults.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
EMBEDDING_USD_PER_MILLION=
